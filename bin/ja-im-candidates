#!/usr/bin/env ruby
# frozen_string_literal: true

# ja-IM で言い換えるかどうかをまだ決めていないキー（en と ja にあって ja-IM に無いキー）を一覧する
#
#   bin/ja-im-candidates                          # JSON（Web UI）と yml（Rails）の両方
#   bin/ja-im-candidates --json                   # JSON だけ
#   bin/ja-im-candidates --yml                    # yml だけ
#   bin/ja-im-candidates --json --ignore <キー>...  # 言い換えないと決めたキーを除外リストに追記する
#
# 言い換えると決めたキーは ja-IM のロケールファイルに書けば候補から消える。
# 言い換えないと決めたキーは --ignore で lib/imastodon/ja_im_candidates.ignore.yml に今の ja の訳文ごと控える。
# ja の訳文が控えと変わると、再び候補に出る。

require 'json'
require 'yaml'
require_relative '../lib/imastodon/ja_im_candidates'

root = File.expand_path('..', __dir__)
sources = {
  json: ['JSON（app/javascript/mastodon/locales）', -> { JaImCandidates.load_json(File.join(root, 'app', 'javascript', 'mastodon', 'locales')) }],
  yml: ['yml（config/locales）', -> { JaImCandidates.load_yml(File.join(root, 'config', 'locales')) }],
}
selected = sources.keys.select { |kind| ARGV.include?("--#{kind}") }

if (index = ARGV.index('--ignore'))
  abort '--ignore には --json か --yml のどちらか一方を付けてください' unless selected.size == 1

  kind = selected.first
  keys = ARGV[(index + 1)..].reject { |arg| arg.start_with?('--') }
  abort '--ignore の後に除外するキーを並べてください' if keys.empty?

  messages = sources.fetch(kind).last.call
  unknown = keys.reject { |key| messages[:ja_messages].key?(key) && messages[:en_messages].key?(key) }
  abort "en と ja の両方にないキーです: #{unknown.join(', ')}" if unknown.any?

  JaImCandidates.record_ignored(kind, keys, messages[:ja_messages])
  puts "#{keys.size} 件を除外リストに追記しました（#{kind}）"
  exit
end

selected = sources.keys if selected.empty?
ignored = JaImCandidates.load_ignored

selected.each do |kind|
  label, loader = sources.fetch(kind)
  finder = JaImCandidates.new(**loader.call, ignored: ignored.fetch(kind))

  puts "== #{label}"
  puts
  puts '語ごとの言い換え率（言い換え済み / 除外済み / ja で含むキー）'
  finder.coverage.each do |term, count|
    next if count[:total].zero?

    puts format('  %<term>s → %<to>s  %<overridden>d / %<ignored>d / %<total>d',
                term: term, to: JaImCandidates::TERMS[term], **count)
  end
  puts

  candidates = finder.candidates
  puts "未判断のキー（#{candidates.size} 件。★は言い換える語を含むもの）"
  candidates.each do |candidate|
    puts "  #{candidate.matched ? '★' : '  '}#{candidate.key}"
    puts "      ja: #{candidate.ja}"
    puts "      除外したときの ja: #{candidate.ignored_ja}" if candidate.ignored_ja
    puts "      案: #{candidate.suggestion}" if candidate.matched
  end
  puts
end
